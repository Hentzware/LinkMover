<UserControl x:Class="LinkMover.Inventory.Views.InventoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Padding="16,4" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Aktualisieren" Padding="16,4"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Foreground="{DynamicResource LinkMover.Brushes.Muted}"/>
            <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     Padding="6,4" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Leeren" Margin="8,0,0,0" Padding="12,4"
                    Command="{Binding ClearFilterCommand}"/>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource LinkMover.Brushes.MutedFaint}">
                <Run Text="{Binding VisibleCount, Mode=OneWay}"/>
                <Run Text=" von "/>
                <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource MahApps.Brushes.Gray10}" Margin="0,0,0,8"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource LinkMover.Brushes.Muted}"/>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding EntriesView}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quelle (Junction)" Binding="{Binding SourcePath}" Width="*"
                                    SortMemberPath="SourcePath"
                                    FontFamily="Consolas"/>
                <DataGridTextColumn Header="Ziel (Daten)" Binding="{Binding TargetPath}" Width="*"
                                    SortMemberPath="TargetPath"
                                    FontFamily="Consolas"/>
                <DataGridTextColumn Header="Erstellt" Binding="{Binding Created, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    SortMemberPath="Created"
                                    Width="140"/>
                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="100"
                                    SortMemberPath="SizeBytes"
                                    FontFamily="Consolas">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Ziel" Width="80" SortMemberPath="TargetExists">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Padding="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetExists}" Value="True">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="{DynamicResource LinkMover.Brushes.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TargetExists}" Value="False">
                                                <Setter Property="Text" Value="Fehlt"/>
                                                <Setter Property="Foreground" Value="{DynamicResource LinkMover.Brushes.Danger}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Aktionen" Width="200" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Padding="6,2" Margin="0,0,2,0"
                                        ToolTip="Im Explorer öffnen"
                                        Command="{Binding DataContext.OpenInExplorerCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="6,2" Margin="0,0,2,0"
                                        ToolTip="Ziel auf anderen Pfad verschieben"
                                        Command="{Binding DataContext.RepointCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="6,2" Margin="0,0,2,0"
                                        ToolTip="Junction wiederherstellen (Daten zurück an Quelle)"
                                        Command="{Binding DataContext.RestoreCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="Restore" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="6,2"
                                        ToolTip="Junction entfernen (Ziel bleibt)"
                                        Foreground="{DynamicResource LinkMover.Brushes.Danger}"
                                        Command="{Binding DataContext.RemoveJunctionCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="LinkOff" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
