<Window x:Class="LinkMover.Inventory.Views.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Junction wiederherstellen" Height="420" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Junction wiederherstellen"
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Padding="12" Background="#F5F5F5" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock>
                    <Run Text="Quelle (Junction): " Foreground="#666"/>
                    <Run Text="{Binding Source, Mode=OneWay}" FontFamily="Consolas"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Ziel (Daten): " Foreground="#666"/>
                    <Run Text="{Binding Target, Mode=OneWay}" FontFamily="Consolas"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                Die Daten werden vom Ziel zurück an die Quell-Position kopiert. Anschließend wird die Junction entfernt
                und durch ein echtes Verzeichnis ersetzt. Programme, die ursprünglich auf den Quell-Pfad zugegriffen haben,
                arbeiten danach wieder mit physischen Daten an dieser Stelle.
            </TextBlock>
            <CheckBox Content="Original-Ziel nach Erfolg löschen" IsChecked="{Binding DeleteTargetAfter}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StageLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ProgressBar Height="20" Minimum="0" Maximum="{Binding TotalBytes}"
                         Value="{Binding BytesProcessed, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}"/>
            <TextBlock Text="{Binding ProgressDetail}" Foreground="#666" Margin="0,4,0,8"/>
            <TextBlock Text="Aktuelle Datei:" Foreground="#888" Margin="0,8,0,2"/>
            <TextBlock Text="{Binding CurrentFile}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Visibility="{Binding ShowResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ResultHeadline}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsResultSuccess}" Value="True">
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResultSuccess}" Value="False">
                                <Setter Property="Foreground" Value="#C62828"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Padding="20,6" Margin="0,0,8,0"
                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Starten" Command="{Binding StartCommand}" Padding="24,8" FontWeight="SemiBold"
                    Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Schließen" Command="{Binding CloseCommand}" Padding="20,6"
                    Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</Window>
