<UserControl x:Class="LinkMover.JunctionCreation.Views.Steps.DoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" Margin="0,0,0,16"
                Background="{DynamicResource LinkMover.Brushes.SuccessBackground}" BorderBrush="{DynamicResource LinkMover.Brushes.Success}" BorderThickness="1">
            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Quelle (Junction)" Foreground="{DynamicResource LinkMover.Brushes.Muted}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Context.Source}" FontFamily="Consolas"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ziel (Daten)" Foreground="{DynamicResource LinkMover.Brushes.Muted}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Context.Target}" FontFamily="Consolas" Margin="0,4,0,0"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Übertragene Bytes" Foreground="{DynamicResource LinkMover.Brushes.Muted}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BytesText}" Margin="0,4,0,0"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Übertragene Dateien" Foreground="{DynamicResource LinkMover.Brushes.Muted}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FilesText}" Margin="0,4,0,0"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Dauer" Foreground="{DynamicResource LinkMover.Brushes.Muted}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ElapsedText}" Margin="0,4,0,0"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Trockenlauf — keine echten Änderungen am Dateisystem."
                   Foreground="{DynamicResource LinkMover.Brushes.Warning}" FontWeight="SemiBold"
                   Visibility="{Binding Context.DryRun, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Im Inventar öffnen" Command="{Binding OpenInventoryCommand}" Padding="20,6" Margin="0,0,8,0"/>
            <Button Content="Neue Junction erstellen" Command="{Binding RestartCommand}" Padding="24,8" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
