<UserControl x:Class="LinkMover.JunctionCreation.Views.Steps.PreFlightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:LinkMover.Core.Models;assembly=LinkMover.Core"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vorab-Prüfungen" FontSize="16" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Foreground="{DynamicResource LinkMover.Brushes.Muted}" Margin="0,0,0,16" TextWrapping="Wrap">
            <Run Text="Quelle: "/><Run Text="{Binding Context.Source, Mode=OneWay}" FontFamily="Consolas"/>
            <LineBreak/>
            <Run Text="Ziel: "/><Run Text="{Binding Context.Target, Mode=OneWay}" FontFamily="Consolas"/>
        </TextBlock>

        <TextBlock Grid.Row="2" Text="Prüfung läuft…"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                   Foreground="{DynamicResource LinkMover.Brushes.Muted}" Margin="0,0,0,12"/>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Context.PreFlight.Checks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" Margin="0,0,0,4" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Severity}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Error}">
                                                <Setter Property="Foreground" Value="{DynamicResource LinkMover.Brushes.Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource LinkMover.Brushes.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Ok}">
                                                <Setter Property="Foreground" Value="{DynamicResource LinkMover.Brushes.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zurück" Command="{Binding BackCommand}" Padding="20,6" Margin="0,0,8,0"/>
            <Button Content="Weiter" Command="{Binding ContinueCommand}" Padding="24,8" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
