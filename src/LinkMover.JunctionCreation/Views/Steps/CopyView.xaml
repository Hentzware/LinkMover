<UserControl x:Class="LinkMover.JunctionCreation.Views.Steps.CopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Daten werden kopiert" FontSize="16" Margin="0,0,0,16"/>

        <ProgressBar Grid.Row="1" Height="24" Minimum="0" Maximum="{Binding TotalBytes}"
                     Value="{Binding BytesCopied, Mode=OneWay}"
                     IsIndeterminate="{Binding IsIndeterminate}"/>

        <TextBlock Grid.Row="2" Text="{Binding ProgressLabel}" Foreground="{DynamicResource LinkMover.Brushes.Muted}"
                   Margin="0,8,0,0"/>

        <TextBlock Grid.Row="3" Text="Aktuelle Datei:" Foreground="{DynamicResource LinkMover.Brushes.MutedFaint}" Margin="0,16,0,2"/>
        <TextBlock Grid.Row="4" Text="{Binding CurrentFile}" FontFamily="Consolas"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Padding="20,6"
                    IsEnabled="{Binding IsBusy}"/>
        </StackPanel>
    </Grid>
</UserControl>
