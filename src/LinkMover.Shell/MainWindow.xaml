<Window x:Class="LinkMover.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:nav="clr-namespace:LinkMover.Core.Navigation;assembly=LinkMover.Core"
        mc:Ignorable="d"
        Title="LinkMover" Height="600" Width="960">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Row="0" Grid.Column="0"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 BorderThickness="0,0,1,0"
                 BorderBrush="#DDD"
                 Padding="0,12,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" FontSize="16" Padding="16,10"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl Grid.Row="0" Grid.Column="1"
                        prism:RegionManager.RegionName="{x:Static nav:RegionNames.Content}"/>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="LinkMover"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
